# From your Supabase project: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# From your Spotify app at https://developer.spotify.com/dashboard (the Client ID only, never the secret)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
